# Documentation only. Spring Boot does not auto-load .env files.
# Configure these in Codespaces/deployment secrets, or export them into the process environment.
DB_URL=jdbc:postgresql://YOUR-POOLED-HOST/neondb?sslmode=require&channelBinding=require
DB_USERNAME=buildease_runtime
DB_PASSWORD=REPLACE_WITH_RUNTIME_ROLE_PASSWORD
MIGRATION_DB_URL=jdbc:postgresql://YOUR-DIRECT-HOST/neondb?sslmode=require&channelBinding=require
MIGRATION_DB_USERNAME=YOUR_MIGRATION_ROLE
MIGRATION_DB_PASSWORD=REPLACE_WITH_MIGRATION_ROLE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_OR_MORE_RANDOM_BYTES
SECURE_COOKIES=true
# Only for the explicit bootstrap command; remove from the environment after use.
BOOTSTRAP_EMAIL=admin@example.invalid
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_PRIVATE_TEMPORARY_PASSWORD

# Public identity links and provider-neutral transactional email.
PUBLIC_URL=http://localhost:5173
MAIL_FROM=no-reply@example.invalid
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_STARTTLS=true

# Private S3-compatible photo storage.
OBJECT_STORAGE_BUCKET=buildease-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=https://s3.example.invalid
OBJECT_STORAGE_PATH_STYLE=true
WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
AUTOMATION_DELAY_MS=60000
